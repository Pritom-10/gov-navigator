generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleBn     String
  titleEn     String
  category    String   // NID, Land, Passport, Certificate...
  description String
  officeType  String   // e.g. "Union Parishad", "Upazila Land Office"
  feeBdt      Int?
  feeNote     String?
  timeEstimate String?
  sourceUrl   String?
  verifiedAt  DateTime?
  embedding   Unsupported("vector(1536)")?
  steps       Step[]
  documents   Document[]
  roadmaps    Roadmap[]
  createdAt   DateTime @default(now())
}

model Step {
  id        String  @id @default(cuid())
  serviceId String
  order     Int
  titleBn   String
  detailBn  String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@index([serviceId, order])
}

model Document {
  id         String  @id @default(cuid())
  serviceId  String
  nameBn     String
  required   Boolean @default(true)
  note       String?
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model User {
  id       String    @id @default(cuid())
  email    String    @unique
  name     String?
  roadmaps Roadmap[]
}

model Roadmap {
  id        String   @id @default(cuid())
  userId    String?
  serviceId String
  query     String
  progress  Json     @default("{}") // { stepId: true, docId: true }
  draftText String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  service   Service  @relation(fields: [serviceId], references: [id])
}